aws_region           = "us-west-1"
ami_id               = "ami-REPLACE_WITH_CANONICAL_UBUNTU_26_04_ARM64"
instance_type        = "t4g.small"
vpc_id               = "vpc-REPLACE"
forwarders = {
  dns-1 = { subnet_id = "subnet-REPLACE_WITH_FIRST_PUBLIC_SUBNET" }
  dns-2 = { subnet_id = "subnet-REPLACE_WITH_SECOND_PUBLIC_SUBNET_IN_ANOTHER_AZ" }
}
key_name             = "REPLACE_WITH_EXISTING_EC2_KEY_PAIR"
admin_cidr           = "203.0.113.10/32" # Documentation address: replace with your public IP.
dns_client_cidrs     = ["0.0.0.0/0"] # Public recursive DNS; override to restrict.
tags                 = { Environment = "dev" }
